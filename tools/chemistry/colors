    <style>
        body {
            font-family: 'Noto Sans Sinhala', sans-serif;
            background: linear-gradient(135deg, #050811 0%, #0c101d 50%, #04060c 100%);
            color: #f8fafc;
            min-height: 100vh;
        }

        /* Stage Area Container */
        .stage-container {
            position: relative;
            width: 100%;
            height: 320px;
            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        /* Bunsen Burner Hardware Assembly */
        .burner-assembly {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 10;
        }

        .burner-tube {
            width: 24px;
            height: 90px;
            background: linear-gradient(to right, #64748b, #cbd5e1, #475569);
            border-radius: 4px 4px 0 0;
            box-shadow: inset -2px 0 5px rgba(0,0,0,0.5), inset 2px 0 5px rgba(255,255,255,0.4);
        }

        /* Perfectly Aligned Layered Flame System (Positioned on top of burner tube) */
        .flame-container {
            position: absolute;
            bottom: 108px; /* Perfectly aligned to the top lip of the 90px tube + base */
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            width: 140px;
            height: 220px;
            pointer-events: none;
            z-index: 15;
        }

        .flame-layer {
            position: absolute;
            bottom: 0;
            border-radius: 50% 50% 35% 35% / 60% 60% 40% 40%;
            transform-origin: center bottom;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            filter: blur(2px);
        }

        /* Outer Glow Aura */
        .flame-aura {
            width: 130px;
            height: 210px;
            opacity: 0.35;
            filter: blur(22px);
            border-radius: 50%;
            transition: all 0.8s ease-in-out;
        }

        /* Outer Flame Body */
        .flame-outer {
            width: 70px;
            height: 160px;
            opacity: 0.85;
            animation: flameFlicker 0.15s infinite alternate ease-in-out;
        }

        /* Inner Flame Core */
        .flame-inner {
            width: 40px;
            height: 110px;
            opacity: 0.95;
            animation: flameFlicker 0.1s infinite alternate ease-in-out 0.05s;
        }

        /* Base Blue Core (Bunsen Base) */
        .flame-base {
            width: 22px;
            height: 45px;
            background: rgba(59, 130, 246, 0.85);
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.9);
            border-radius: 50% 50% 40% 40% / 60% 60% 40% 40%;
            bottom: 0;
            filter: blur(1px);
        }

        @keyframes flameFlicker {
            0% { transform: scaleX(0.97) scaleY(0.98) rotate(-0.5deg); }
            100% { transform: scaleX(1.03) scaleY(1.02) rotate(0.5deg); }
        }

        /* Platinum Wire & Loop Animation (Aligned with middle of flame) */
        .wire-holder {
            position: absolute;
            right: -180px;
            bottom: 160px; /* Aligned height for precise entry into flame core */
            width: 260px;
            height: 8px;
            transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
            z-index: 25;
        }

        .wire-rod {
            width: 160px;
            height: 4px;
            background: linear-gradient(to right, #475569, #94a3b8, #cbd5e1);
            border-radius: 2px;
        }

        .wire-loop {
            width: 14px;
            height: 14px;
            border: 2.5px solid #cbd5e1;
            border-radius: 50%;
            margin-left: -2px;
            position: relative;
            box-shadow: 0 0 4px rgba(255,255,255,0.6);
            transition: background-color 0.8s ease, border-color 0.8s ease, box-shadow 0.8s ease;
        }

        /* Sample Salt Particle inside Loop */
        .sample-bead {
            position: absolute;
            inset: 1px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 0 6px rgba(255, 255, 255, 0.9);
            transition: all 0.8s ease;
        }

        .wire-in-flame {
            transform: translateX(-155px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.5);
            border-radius: 3px;
        }
    </style>
