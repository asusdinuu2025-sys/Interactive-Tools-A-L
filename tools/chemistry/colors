        let currentElement = 'Li';
        let isTesting = false;

        // DOM Elements
        const elementGrid = document.getElementById('elementGrid');
        const wireHolder = document.getElementById('wireHolder');
        const sampleBead = document.getElementById('sampleBead');
        const flameOuter = document.getElementById('flameOuter');
        const flameInner = document.getElementById('flameInner');
        const flameAura = document.getElementById('flameAura');
        const roomGlow = document.getElementById('roomGlow');
        const statusBadge = document.getElementById('statusBadge');
        const infoElement = document.getElementById('infoElement');
        const infoColor = document.getElementById('infoColor');
        const infoSpectrum = document.getElementById('infoSpectrum');

        // Populate Buttons dynamically
        function initButtons() {
            elementGrid.innerHTML = '';
            Object.keys(flameData).forEach(key => {
                const btn = document.createElement('button');
                btn.id = `btn-${key}`;
                btn.onclick = () => selectElement(key);
                btn.className = `p-2 rounded-xl border text-center transition duration-200 flex flex-col items-center justify-center cursor-pointer ${
                    key === currentElement 
                    ? 'bg-amber-500/30 border-amber-400 text-white shadow-lg ring-2 ring-amber-400/50' 
                    : 'bg-slate-800/60 border-slate-700/80 text-slate-300 hover:bg-slate-700/60'
                }`;
                btn.innerHTML = `<span class="text-xs font-bold">${key}</span>`;
                elementGrid.appendChild(btn);
            });
        }

        // Selection Handler
        function selectElement(key) {
            if (isTesting) return;
            currentElement = key;
            
            // Update UI buttons
            Object.keys(flameData).forEach(k => {
                const b = document.getElementById(`btn-${k}`);
                if (b) {
                    b.className = k === key 
                    ? 'p-2 rounded-xl border text-center transition duration-200 flex flex-col items-center justify-center cursor-pointer bg-amber-500/30 border-amber-400 text-white shadow-lg ring-2 ring-amber-400/50'
                    : 'p-2 rounded-xl border text-center transition duration-200 flex flex-col items-center justify-center cursor-pointer bg-slate-800/60 border-slate-700/80 text-slate-300 hover:bg-slate-700/60';
                }
            });

            resetFlame();
        }

        // Run Flame Test Animation Sequence
        function runFlameTest() {
            if (isTesting) return;
            isTesting = true;

            const data = flameData[currentElement];

            // 1. Move Platinum wire directly into the flame center
            wireHolder.classList.add('wire-in-flame');
            statusBadge.innerText = `${data.name.split(' ')[0]} නියැදිය දැල්ලට ඇතුළු කරමින්...`;
            statusBadge.className = 'mt-4 px-4 py-1 rounded-full text-xs font-semibold bg-amber-900/60 text-amber-200 border border-amber-600 shadow text-center z-10 animate-pulse';

            // 2. Change Flame colors smoothly after wire reaches center
            setTimeout(() => {
                flameOuter.style.background = data.outerFlame;
                flameInner.style.background = data.innerFlame;
                flameAura.style.backgroundColor = data.aura;
                roomGlow.style.backgroundColor = data.aura;
                sampleBead.style.backgroundColor = data.beadColor;
                sampleBead.style.boxShadow = `0 0 10px ${data.beadColor}`;

                // Update Info Display
                infoElement.innerText = data.name;
                infoColor.innerText = data.colorName;
                infoSpectrum.innerText = data.explanation;

                statusBadge.innerText = `නිරීක්ෂණය: ${data.colorName}`;
                statusBadge.className = 'mt-4 px-4 py-1 rounded-full text-xs font-semibold bg-emerald-900/60 text-emerald-200 border border-emerald-600 shadow text-center z-10';
            }, 700);
        }

        // Reset Flame to Default Blue Bunsen Flame
        function resetFlame() {
            isTesting = false;
            wireHolder.classList.remove('wire-in-flame');

            // Default Blue Flame Style
            flameOuter.style.background = 'linear-gradient(to top, #2563eb, #3b82f6, #60a5fa)';
            flameInner.style.background = 'linear-gradient(to top, #1d4ed8, #93c5fd, #ffffff)';
            flameAura.style.backgroundColor = 'rgba(59, 130, 246, 0.4)';
            roomGlow.style.backgroundColor = 'rgba(37, 99, 235, 0.1)';
            sampleBead.style.backgroundColor = '#ffffff';
            sampleBead.style.boxShadow = '0 0 6px rgba(255, 255, 255, 0.9)';

            const data = flameData[currentElement];
            statusBadge.innerText = `නියැදිය: ${data.name.split(' ')[0]}`;
            statusBadge.className = 'mt-4 px-4 py-1 rounded-full text-xs font-semibold bg-slate-900 text-slate-300 border border-slate-700/80 shadow text-center z-10';

            infoElement.innerText = data.name;
            infoColor.innerText = data.colorName;
            infoSpectrum.innerText = data.explanation;
        }

        // Initializer
        window.onload = function() {
            initButtons();
            resetFlame();
        };
    </script>
