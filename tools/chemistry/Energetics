<script>

function applyTheme(theme){
  document.body.classList.toggle('dark', theme === 'dark');
  localStorage.setItem('energetics-theme', theme);
}
function toggleTheme(){
  applyTheme(document.body.classList.contains('dark') ? 'light' : 'dark');
}
(function(){
  const saved=localStorage.getItem('energetics-theme');
  if(saved) applyTheme(saved);
})();

function n(id){return parseFloat(document.getElementById(id).value)}
function fmt(x){return Number.isFinite(x)?x.toFixed(4).replace(/\.?0+$/,''): 'Invalid input'}

function calcQ(){
 let q=n('q_m')*n('q_c')*(n('q_tf')-n('q_ti'));
 document.getElementById('q_out').innerHTML=`<b>ΔT = ${fmt(n('q_tf')-n('q_ti'))} K</b><br>q = <b>${fmt(q)} J</b> = <b>${fmt(q/1000)} kJ</b><br><span class="${q>=0?'good':'bad'}">${q>=0?'තාපය අවශෝෂණය වේ — endothermic':'තාපය නිකුත් වේ — exothermic'}</span>`;
}
function calcCal(){
 let m=n('cal_m'), c=n('cal_c'), dt=n('cal_dt'), C=n('cal_C'), mol=n('cal_n');
 let q=(m*c+C)*dt, qr=-q, dh=qr/mol/1000;
 document.getElementById('cal_out').innerHTML=`q<sub>surroundings</sub> = <b>${fmt(q)} J</b><br>q<sub>reaction</sub> = <b>${fmt(qr)} J</b><br>ΔH = q<sub>reaction</sub>/n = <b>${fmt(dh)} kJ mol⁻¹</b><br><span class="${dh<0?'good':'bad'}">${dh<0?'තාපදායක (Exothermic)':'තාපශෝෂක (Endothermic)'}</span>`;
}
function calcHF(){
 let v=n('hf_p')-n('hf_r');
 document.getElementById('hf_out').innerHTML=`ΔH°<sub>rxn</sub> = <b>${fmt(v)} kJ mol⁻¹</b><br><span class="${v<0?'good':'bad'}">${v<0?'තාපදායක (Exothermic)':'තාපශෝෂක (Endothermic)'}</span>`;
}
function calcBond(){
 let v=n('bb')-n('bf');
 document.getElementById('bond_out').innerHTML=`ΔH ≈ <b>${fmt(v)} kJ mol⁻¹</b><br><span class="${v<0?'good':'bad'}">${v<0?'තාපදායක (Exothermic)':'තාපශෝෂක (Endothermic)'}</span>`;
}
function addහෙස්(){
 let tr=document.createElement('tr');
 tr.innerHTML=`<td><input class="hm" type="number" step="any" value="1"></td><td><input class="hv" type="number" step="any" value="0"></td><td><button onclick="removeහෙස්(this)">×</button></td>`;
 document.getElementById('හෙස්Table').appendChild(tr);
}
function removeහෙස්(btn){btn.closest('tr').remove()}
function calcහෙස්(){
 let ms=[...document.querySelectorAll('.hm')], vs=[...document.querySelectorAll('.hv')];
 let total=0;
 for(let i=0;i<ms.length;i++) total+=parseFloat(ms[i].value)*parseFloat(vs[i].value);
 document.getElementById('හෙස්_out').innerHTML=`Σ(multiplier × ΔH) = <b>${fmt(total)} kJ mol⁻¹</b>`;
}
function calcබෝන්(){
 let hf=n('bh_f'), sub=n('bh_sub'), at=n('bh_at'), ie=n('bh_ie'), eg=n('bh_eg');
 let formation=hf-sub-at-ie-eg;
 let diss=-formation;
 document.getElementById('bh_out').innerHTML=`Lattice formation එන්තැල්පි = <b>${fmt(formation)} kJ mol⁻¹</b><br>Lattice dissociation එන්තැල්පි = <b>${fmt(diss)} kJ mol⁻¹</b><br><span class="good">Dissociation value is positive.</span>`;
}
function calcS(){
 let v=n('s_p')-n('s_r');
 document.getElementById('s_out').innerHTML=`ΔS°<sub>rxn</sub> = <b>${fmt(v)} J K⁻¹ mol⁻¹</b>`;
}
function calcG(){
 let H=n('g_h'), S=n('g_s')/1000, T=n('g_t');
 let G=H-T*S;
 let state=G<0?'දී ඇති T සහ සම්මත තත්ත්ව යටතේ ස්වයංසිද්ධ වේ':(G>0?'දී ඇති T සහ සම්මත තත්ත්ව යටතේ ස්වයංසිද්ධ නොවේ':'සමතුලිතතාව');
 document.getElementById('g_out').innerHTML=`ΔG° = <b>${fmt(G)} kJ mol⁻¹</b><br><span class="${G<0?'good':G>0?'bad':'warn'}">${state}</span>`;
}
function calcExtent(){
 let v=n('ex_h')*n('ex_x');
