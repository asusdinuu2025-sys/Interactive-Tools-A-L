<div class="row">
<div><label>ΔH° (kJ mol⁻¹)<input id="ex_h" type="number" step="any" value="-483.7"></label></div>
<div><label>Reaction extent ξ (mol)<input id="ex_x" type="number" step="any" value="2"></label></div>
</div>
<button onclick="calcExtent()">ΔH ගණනය කරන්න</button>
<div class="result" id="ex_out"></div>
</div>

</div>
